# Copy this file to .env and fill in your API keys
# Usage: cp .env.example .env
#
# Note: the scripts do not read .env by themselves. Export the variables in your
# shell (or `set -a; source .env; set +a`) before running them, e.g.:
#   set -a; source .env; set +a; ./scripts/generate_book.sh --topic "..."

# ── AI providers for text (outline, chapters, appendices, references) ─────────
# At least one is needed for text generation. Without any, the pipeline can only
# compile an outline/chapters you wrote yourself.

# Gemini (recommended — free tier is enough for a book)
GEMINI_API_KEY=

# Groq (fast free tier, used as fallback)
GROQ_API_KEY=

# Anthropic / Claude (optional)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Custom / any OpenAI-compatible endpoint ──────────────────────────────────
# Works with OpenAI, OpenRouter, DeepSeek, Together, Mistral, xAI, Fireworks,
# LM Studio (http://localhost:1234/v1), vLLM, llama.cpp server, and anything
# else that speaks POST <base>/chat/completions with a bearer token.
# Plain OpenAI only needs OPENAI_API_KEY + OPENAI_BASE_URL.
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Aliases for the custom endpoint (use these for plain OpenAI):
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=deepseek-chat                 # DeepSeek: https://api.deepseek.com/v1
# OPENAI_MODEL=meta-llama/llama-3.1-70b-instruct  # OpenRouter
# OPENAI_MODEL=llama3.1-8b-instruct          # LM Studio / vLLM (local)

# Pin one provider instead of the automatic Gemini → Ollama → Groq → Anthropic → custom chain
# SMART_API_PROVIDER=gemini

# ── Optional defaults ────────────────────────────────────────────────────────
AUTHOR_PEN_NAME=
